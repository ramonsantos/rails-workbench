{
  "name": "rails-workbench",
  "displayName": "Rails Workbench",
  "description": "Rails-oriented VS Code tools: partial and URL helper navigation, completion, and configurable routes loading.",
  "icon": "media/icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:erb",
    "onLanguage:haml",
    "onLanguage:slim"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Rails Workbench",
      "properties": {
        "rails-workbench.partials.viewFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "html.erb",
            "html.haml",
            "html.slim"
          ],
          "description": "Template extensions used when resolving Rails partial files."
        },
        "rails-workbench.routes.command": {
          "type": "string",
          "default": "bundle exec rails routes",
          "description": "Shell command whose stdout is parsed as `rails routes` output (e.g. docker compose exec -T web bin/rails routes)."
        },
        "rails-workbench.routes.workingDirectory": {
          "type": "string",
          "default": "",
          "description": "Working directory for the routes command. When empty, uses the detected Rails application root."
        }
      }
    },
    "commands": [
      {
        "command": "rails-workbench.routes.insert",
        "category": "Rails Workbench",
        "title": "Insert URL Helper"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
